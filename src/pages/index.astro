---
import Background from "@components/Background.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout sideBarActiveItemID="home">
  <div class="min-h-[75vh]"></div>
  <div class="pointer-events-none">
    <Background />
    <div
      class="absolute right-0 -top-40 bottom-0 left-0 m-auto lg:left-[25rem] z-10 lg:mr-auto lg:ml-0 w-[300px] h-[400px] lg:w-[600px] lg:mt-10 lg:top-0"
    >
      <div class="-z-10">
        <div class="text-3xl lg:text-5xl font-bold text-white">
          I'm Junipero Verbeke
        </div>
        <div class="text-xl lg:text-3xl py-3 font-bold">
          Student in Electrical Engineering
        </div>
        <div class="py-2">
          <text class="lg:text-lg text-justify text-white">
            I am a graduate student in electrical engineering at San Jose State
            University and an Applied Engineer at Veritas Managed Solutions,
            Inc. I focus on embedded systems, control theory, and dynamic
            modeling, with hands-on experience in MATLAB/Simulink, Python, and
            AI/ML for anomaly detection and yield optimization. My passion is hard tech: building and testing real hardware—from flight controller tuning to sensor integration—and turning models into
            robust control software.
          </text>
        </div>
      </div>
      <div class="mt-8 pointer-events-auto">
        <a class="btn btn-primary text-white" href="/resume">See my resume</a>
        <a href="/contact" class="btn btn-outline ml-5">
          Contact</a
        >
      </div>
    </div>
  </div>
</BaseLayout>
